diff --git a/connectors/capsolver/lifecycle.test.ts b/connectors/capsolver/lifecycle.test.ts
new file mode 100644
index 0000000..587cb4d
--- /dev/null
+++ b/connectors/capsolver/lifecycle.test.ts
@@ -0,0 +1,45 @@
+import { assertEquals } from "@std/assert";
+import { fromFileUrl } from "@std/path";
+import type { RunInput } from "@shared/core";
+import { loadFixture, runEndpoint, testSealedUnit } from "@shared/testing";
+
+const HERE = fromFileUrl(new URL("./", import.meta.url));
+const INPUTS = JSON.parse(
+    await Deno.readTextFile(`${HERE}test-inputs.json`),
+) as Record<string, RunInput>;
+
+Deno.test("capsolver: createTask is polled until a token is ready", async () => {
+    const result = await runEndpoint({
+        unit: await testSealedUnit("capsolver#solve/recaptcha-v2"),
+        input: INPUTS["recaptcha-v2"],
+        mode: "replay",
+        fixture: await loadFixture(
+            `${HERE}fixtures/synthetic-succeeded.json`,
+        ),
+    });
+    assertEquals(result.httpStatus, 200);
+    assertEquals(result.isProviderError, false);
+    assertEquals(result.output, {
+        errorId: 0,
+        taskId: "synthetic-task-id",
+        status: "ready",
+        solution: { gRecaptchaResponse: "synthetic-token" },
+    });
+    assertEquals(result.usage, {
+        credits: { default: 0.0008 },
+        evidence: { CALL: 1 },
+    });
+});
+
+Deno.test("capsolver: all three first-scope endpoints compile", async () => {
+    for (
+        const id of [
+            "capsolver#solve/recaptcha-v2",
+            "capsolver#solve/recaptcha-v3",
+            "capsolver#solve/turnstile",
+        ]
+    ) {
+        const unit = await testSealedUnit(id);
+        assertEquals(unit.doc.provider, "capsolver");
+    }
+});
diff --git a/connectors/capsolver/provider.ts b/connectors/capsolver/provider.ts
new file mode 100644
index 0000000..51f5d1c
--- /dev/null
+++ b/connectors/capsolver/provider.ts
@@ -0,0 +1,156 @@
+import { defineProvider } from "@shared/core";
+
+/**
+ * CapSolver — asynchronous CAPTCHA token tasks for authorized browser
+ * automation, testing, and public-web data workflows.
+ *
+ * CapSolver authenticates in the JSON body rather than a header. The custom
+ * injector adds clientKey to both createTask and same-origin getTaskResult
+ * calls while keeping the secret outside lifecycle code and fixtures.
+ */
+export default defineProvider({
+    name: "capsolver",
+    meta: {
+        displayName: "CapSolver",
+        summary:
+            "Solve reCAPTCHA and Cloudflare Turnstile token challenges for authorized automation.",
+        description: "CAPTCHA handling for browser automation, QA, RPA, " +
+            "and public-web data workflows. Submit a supported challenge, " +
+            "poll the task to completion, and receive the provider's token " +
+            "response. This first connector scope covers proxyless " +
+            "reCAPTCHA v2, reCAPTCHA v3, and Cloudflare Turnstile tasks.",
+        homepageUrl: "https://www.capsolver.com",
+        docsUrl: "https://docs.capsolver.com/en/guide/getting-started/",
+        categories: ["captcha-solving"],
+        notes: [
+            "Use only on sites and workflows you are authorized to automate.",
+            "Tasks are retained for five minutes and may be queried at most 120 times.",
+        ],
+    },
+    auth: {
+        inject: ({ data, utils }) => ({
+            ...data.request,
+            body: utils.json.merge(data.request.body ?? {}, {
+                clientKey: data.params.apiKey,
+            }),
+        }),
+    },
+    request: {
+        baseUrl: "https://api.capsolver.com",
+        headers: { "Content-Type": "application/json" },
+    },
+    timeouts: { requestMs: 30_000, runMs: 300_000, pollMs: 3_000 },
+    lifecycle: {
+        start: async ({ utils, logger }) => {
+            const res = await utils.request();
+            if (res.status < 200 || res.status >= 300) {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            const errorId = utils.json.optionalNum(res.body, "$.errorId");
+            if (errorId !== undefined && errorId > 0) {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: 422,
+                    providerHttpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            const status = utils.json.optionalGet(res.body, "$.status");
+            if (status === "ready") {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: 200,
+                    providerHttpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            const taskId = utils.json.optionalGet(res.body, "$.taskId");
+            if (typeof taskId !== "string" || taskId === "") {
+                throw Object.assign(
+                    new Error("CapSolver createTask returned no taskId"),
+                    { retriable: false },
+                );
+            }
+            logger.info("CapSolver task created", { taskId });
+            return {
+                kind: "RUNNING",
+                state: { externalRunId: taskId },
+            };
+        },
+        poll: async ({ data, utils, logger }) => {
+            const taskId = data.lifecycle.state.externalRunId;
+            if (taskId === undefined) {
+                throw Object.assign(
+                    new Error("CapSolver poll without externalRunId in state"),
+                    { retriable: false },
+                );
+            }
+            const res = await utils.http({
+                method: "POST",
+                path: "/getTaskResult",
+                body: { taskId },
+            });
+            if (res.status < 200 || res.status >= 300) {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            const errorId = utils.json.optionalNum(res.body, "$.errorId");
+            if (errorId !== undefined && errorId > 0) {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: 422,
+                    providerHttpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            const status = utils.json.optionalGet(res.body, "$.status");
+            if (status === "ready") {
+                return {
+                    kind: "COMPLETED",
+                    httpStatus: 200,
+                    providerHttpStatus: res.status,
+                    output: res.body,
+                };
+            }
+            if (status === "idle" || status === "processing") {
+                return { kind: "RUNNING" };
+            }
+            logger.warn("CapSolver task status was not recognized", {
+                taskId,
+                status: String(status),
+            });
+            return {
+                kind: "COMPLETED",
+                httpStatus: 502,
+                providerHttpStatus: res.status,
+                output: res.body,
+            };
+        },
+    },
+    output: {
+        fromError: ({ data, utils }) => {
+            const description = utils.json.optionalGet(
+                data.output,
+                "$.errorDescription",
+            );
+            const code = utils.json.optionalGet(data.output, "$.errorCode");
+            return {
+                message: typeof description === "string" && description !== ""
+                    ? description
+                    : "CapSolver API error",
+                ...(typeof code === "string" && code !== "" ? { code } : {}),
+                raw: data.output,
+            };
+        },
+    },
+    usage: {
+        credits: { default: { label: "US dollars" } },
+    },
+});
